{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thesis",
  "description": "产品论点：决策内核的北极星，必须可被证伪。",
  "type": "object",
  "required": ["schemaVersion", "id", "statement", "needsRevision"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["4.0", "4.1"] },
    "id": { "type": "string", "pattern": "^T-[0-9]{2,}$" },
    "statement": { "type": "string", "description": "一句话论点：为【目标用户】解决【核心问题】，通过【解法】，带来【价值】。" },
    "targetUser": { "type": "string" },
    "coreProblem": { "type": "string" },
    "solutionHypothesis": { "type": "string" },
    "whyNow": { "type": "string" },
    "successSignal": { "type": "string" },
    "needsRevision": { "type": "boolean", "default": false, "description": "承重假设被推翻时由 writeback 置 true" },
    "bizModel": { "type": "string", "enum": ["B2B", "B2C", "B2B2C", "自用"], "description": "商业模式维度（4.1 新增，optional，用于 /lookup 跨项目维度硬标记）" },
    "stage": { "type": "string", "enum": ["0→1", "1→10", "10→100"], "description": "项目阶段维度（4.1 新增，optional，用于 /lookup 跨项目维度硬标记）" },
    "revisions": {
      "type": "array",
      "description": "论点修订史（P0 唯一的 history 机制）",
      "items": {
        "type": "object",
        "required": ["at", "reason"],
        "properties": {
          "at": { "type": "string", "format": "date" },
          "reason": { "type": "string" },
          "before": { "type": "string" },
          "after": { "type": "string" }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
