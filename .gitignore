# 依赖（零依赖约束，理论上无 node_modules，保险起见）
node_modules/

# 本地工具状态（不入库）
.workbuddy/

# OS 杂项
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp
*.swo

